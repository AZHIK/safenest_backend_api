# ==========================================
# SafeNest Backend Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
APP_NAME=SafeNest API
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Database - PostgreSQL
DB_USER=safenest
DB_PASSWORD=changeme_strong_password
DB_NAME=safenest
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://safenest:changeme_strong_password@localhost:5432/safenest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security - JWT
JWT_SECRET_KEY=generate_a_32_char_secret_key_here!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security - OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads/evidence
TEMP_UPLOAD_DIR=uploads/temp
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/mp4

# Encryption
ENCRYPTION_KEY=generate_32_char_encryption_key_here!!

# Rate Limiting (requests per minute)
RATE_LIMIT_AUTH=5
RATE_LIMIT_SOS=10
RATE_LIMIT_GENERAL=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.safenest.org

# S3/Storage (Placeholder - configure in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=safenest-evidence

# SMS/OTP Provider (Placeholder)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=true

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_TIMEOUT=300
